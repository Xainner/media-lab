# Private settings for deploy/media-lab.sh. Copy to deploy/.web.env (never commit it) and edit.
# deploy/install.sh writes the same variables to its own compose.env.

# The exact HTTPS address people open (behind your reverse proxy) and its host name.
MEDIA_LAB_ORIGIN=https://media.example.com
MEDIA_LAB_HOST=media.example.com
MEDIA_LAB_LISTEN=0.0.0.0
MEDIA_LAB_PORT=8390
# The reverse proxy's IP: the only peer whose X-Forwarded-For is trusted (empty: none).
# The host firewall (/etc/media-lab/media-lab.env) uses the same value.
MEDIA_LAB_PROXY_IP=

# Host directories.
MEDIA_LAB_STATE_DIR=/srv/media-lab/state            # database, artifacts, agent runs
MEDIA_LAB_SECRETS_DIR=/srv/media-lab/secrets        # master.key, agent.key, origin certificate (mode 0700)
MEDIA_LAB_MODELS_DIR=/srv/media-lab/models          # deploy/scripts/download-*.sh
MEDIA_LAB_SHARED_MODELS_DIR=/srv/media-lab/shared-models
MEDIA_LAB_LORAS_DIR=/srv/media-lab/loras            # writable by uid 1000
MEDIA_LAB_FUSED_DIR=/srv/media-lab/fused            # H3 Fused Turbo checkpoint + minimax_h3/vae/

ENABLE_2K=false
ENABLE_BF16=false
QWEN21_ENCODER=qwen3vl_8b_int8_convrot.safetensors
